#!name=Mob Control - Coins Reward
#!desc=金幣收益進階測試：4個基礎數值 + 聯盟/貨幣倍率；新增遞減、連勝、結算資源與季票倍率選項。僅改遠端 /api/settings。
#!category=Gaming
#!arguments=TowerCoins:100000,EgsCoins:5000,EgsFullBar:5000,CardTierMultipliers:10|15|45|180,LeagueScale:100,CurrencyScale:100,DiminishingFactor:1,UndiminishedMilestones:10,WinStreakBonus:5,EndBarResources:1000,SeasonPassType1Scale:2
#!arguments-desc=已測試有效的基數保留；LeagueScale/CurrencyScale=原倍率的乘數(1=不動)。DiminishingFactor原0.5、UndiminishedMilestones原5、WinStreakBonus原2、EndBarResources原200、SeasonPassType1Scale=1(不動)。

# 僅修改設定 API，不能保證每種獎勵類型都使用這些參數。
# 不調整金幣餘額、伺服器存檔、購買驗證、付費會員或廣告設定。

[Body Rewrite]
http-response-jq ^https:\/\/remote-settings-v2\.voodoo-tech\.io\/api\/settings(?:\?|$) 'def putNumber($p;$v): if ((try (getpath($p)|type) catch "null") == "number" and ($v|type)=="number") then setpath($p;$v) else . end; def putArray4($p;$a): if ((try (getpath($p)|type) catch "null") == "array" and ($a|length)==4 and all($a[];type=="number")) then setpath($p;$a) else . end; def scaleArray($p;$factor): if ($factor>0 and $factor!=1 and (try (getpath($p)|type) catch "null")=="array") then (getpath($p)) as $a | if all($a[];type=="number") then setpath($p;($a|map(. * $factor))) else . end else . end; def scaleSeasonPassType1($factor): ["_Game.SeasonPass.SeasonRemoteConfig",0,"RewardsModifierJson"] as $p | if ($factor>0 and $factor!=1 and (try (getpath($p)|type) catch "null")=="string") then (try (getpath($p)|fromjson) catch null) as $obj | if (($obj|type)=="object" and ($obj.RewardsMultiplierByArmoryTiers|type)=="array") then ($obj | .RewardsMultiplierByArmoryTiers |= map( if (.RewardType==1 and (.ArmoryTiersMultiplier|type)=="array" and all(.ArmoryTiersMultiplier[];type=="number")) then .ArmoryTiersMultiplier |= map(. * $factor) else . end )) as $new | setpath($p;($new|tojson)) else . end else . end; ("{{{TowerCoins}}}" | tonumber? // 250) as $tower | ("{{{EgsCoins}}}" | tonumber? // 40) as $egs | ("{{{EgsFullBar}}}" | tonumber? // 40) as $bar | ("{{{CardTierMultipliers}}}" | split("|") | map(tonumber?)) as $cards | ("{{{LeagueScale}}}" | tonumber? // 1) as $league | ("{{{CurrencyScale}}}" | tonumber? // 1) as $currency | ("{{{DiminishingFactor}}}" | tonumber? // 0.5) as $diminish | ("{{{UndiminishedMilestones}}}" | tonumber? // 5) as $milestones | ("{{{WinStreakBonus}}}" | tonumber? // 2) as $streak | ("{{{EndBarResources}}}" | tonumber? // 200) as $endbar | ("{{{SeasonPassType1Scale}}}" | tonumber? // 1) as $season | putNumber(["_Game.Features.CoinsIncome.Core.CoinsIncomeConfiguration",0,"m_TowerCoinsRewardByLeagueTier"];$tower) | putNumber(["_Game.Features.CoinsIncome.Core.CoinsIncomeConfiguration",0,"m_EgsCoinRewardByLeagueTier"];$egs) | putNumber(["_Game.Features.CoinsIncome.Core.CoinsIncomeConfiguration",0,"m_EgsFullBarCoinRewardByLeagueTier"];$bar) | putArray4(["_Game.Features.Voodoo.Live.Core.VoodooLiveConfig",0,"CoinsMultiplierByCardTier"];$cards) | scaleArray(["_Game.Features.CoinsIncome.Core.CoinsIncomeConfiguration",0,"m_LeagueMultiplier"];$league) | scaleArray(["_Game.Common.NewRewards.ScalableCurrencyConfiguration",0,"Multipliers"];$currency) | putNumber(["_Game.Features.CoinsIncome.Core.CoinsIncomeConfiguration",0,"m_DiminishingReturnFactor"];$diminish) | putNumber(["_Game.Features.CoinsIncome.Core.CoinsIncomeConfiguration",0,"m_UndiminishedMilestones"];$milestones) | putNumber(["_Game.Features.WinStreak.Core.WinStreakConfiguration",0,"BonusStateMultiplier"];$streak) | putNumber(["EndLevelSequenceConfig",0,"EndBarResources"];$endbar) | scaleSeasonPassType1($season)'

[MITM]
hostname = %APPEND% remote-settings-v2.voodoo-tech.io
