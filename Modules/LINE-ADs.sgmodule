#!name=Remove LINE ADs + Privacy
#!desc=LINE 去廣告 + 遙測/追蹤/分析阻擋 v20260929.01（需啟用 MitM over HTTP/2）
#!system=ios
#!category=Tweaks

[Rule]
# ============================================================
# 1. LINE Ads / Smart Channel
# ============================================================

# LINE Ads impression / event pixels
URL-REGEX,^https:\/\/a\.line\.me(?::443)?\/er\/lads\/v\d+\/ei(?:\?|$),REJECT-TINYGIF
URL-REGEX,^https:\/\/a\.line\.me(?::443)?\/er\/(?:lass|ladg|lads)\/v\d+\/event\/image(?:\?|$),REJECT-TINYGIF

# LINE Ads APIs
URL-REGEX,^https:\/\/a\.line\.me(?::443)?\/lass\/api\/v\d+\/ads(?:\?|$),REJECT
URL-REGEX,^https:\/\/a\.line\.me(?::443)?\/oa\/v\d+\/e(?:\?|$),REJECT
URL-REGEX,^https:\/\/a\.line\.me(?::443)?\/cs\/v\d+\/oa(?:\?|$),REJECT

# Legacy / compatibility ads gateways
URL-REGEX,^https:\/\/gw\.line\.naver\.jp(?::443)?\/ext\/lgfp\/lad\/v\d+(?:\?|$),REJECT
URL-REGEX,^https:\/\/gw\.line\.naver\.jp(?::443)?\/lass\/api\/v\d+\/ads(?:\?|$),REJECT

# Current LINE Ads / Smart Channel
URL-REGEX,^https:\/\/legy\.line-apps\.com(?::443)?\/ext\/lgfp\/lad\/v\d+(?:\?|$),REJECT
URL-REGEX,^https:\/\/legy\.line-apps\.com(?::443)?\/ext\/smartch\/banner\/sch\/v\d+(?:\?|$),REJECT

# Other explicit ad APIs
URL-REGEX,^https:\/\/w\.line\.me(?::443)?\/adp\/api\/ad\/v\d+\/,REJECT
URL-REGEX,^https:\/\/sch\.line\.me(?::443)?\/api\/v\d+\/ads(?:\?|$),REJECT

# Smart Channel ad media CDN
# Whole host is dedicated to ad media in collected traffic, so no MITM is needed.
DOMAIN,ad.line-scdn.net,REJECT

# Home / GEB promotional banner media
# Observed URL example:
# This host supplied the Home GEB banner creative captured from GetModulesByModuleIds.
DOMAIN,ec-bot-obs.line-scdn.net,REJECT
URL-REGEX,^https:\/\/legy\.line-apps\.com\/line\.gcs\.GcsModuleService\/GetModulesByModuleIds$,REJECT

# LINE Web / LIFF Ads SDK
URL-REGEX,^https:\/\/static\.line-scdn\.net(?::443)?\/ad-sdk\/,REJECT

# LINE Pay / LIFF campaign banner
URL-REGEX,^https:\/\/web-mmap-pay\.line-apps\.com(?::443)?\/tw\/liff\/campaign\/v\d+\/aggregate\/ad\/banner\/,REJECT

# Legacy LINE event/banner assets
URL-REGEX,^https:\/\/scdn\.line-apps\.com(?::443)?\/lan\/image\/line\/bannerImageEvent\/,REJECT
URL-REGEX,^https:\/\/scdn\.line-apps\.com(?::443)?\/lan\/document\/pageEvent\/line\/ios\/,REJECT


# ============================================================
# 2. Telemetry / Tracking / Analytics / Diagnostics
# ============================================================

# LINE generic event tracking
URL-REGEX,^https:\/\/gw\.line\.naver\.jp(?::443)?\/tr\/event(?:\?|$),REJECT
URL-REGEX,^https:\/\/legy\.line-apps\.com(?::443)?\/tr\/event(?:\?|$),REJECT

# Recommendation / content impression collector
URL-REGEX,^https:\/\/crs-event\.line\.me(?::443)?\/v\d+\/imp(?:\?|$),REJECT

# UTS analytics
# uts-front is LINE's analytics endpoint; block the whole collector host.
DOMAIN,uts-front.line-apps.com,REJECT

# Also prevent LIFF/WebView pages from loading the UTS analytics SDK itself.
URL-REGEX,^https:\/\/static\.line-scdn\.net(?::443)?\/uts\/,REJECT

# NELO2 diagnostics / log collector
DOMAIN,nelo2-col.linecorp.com,REJECT

# CIX client-information endpoint.
# Observed requests include OS/app version, carrier, region and timestamp.
# Keep this path-scoped instead of rejecting the entire cix.line-apps.com host.
URL-REGEX,^https:\/\/cix\.line-apps\.com(?::443)?\/R\d+(?:\?|$),REJECT


[MITM]
hostname = %APPEND% a.line.me, gw.line.naver.jp, legy.line-apps.com, w.line.me, sch.line.me, crs-event.line.me, static.line-scdn.net, web-mmap-pay.line-apps.com, scdn.line-apps.com, cix.line-apps.com
